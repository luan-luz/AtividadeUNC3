<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:allowBackup="true"
        android:label="1o"
        android:icon="@android:drawable/ic_menu_agenda"
        android:usesCleartextTraffic="false"
        android:theme="@style/OneOTheme">
        <activity android:name=".MainActivity" android:screenOrientation="unspecified"
            android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <provider
            android:name=".UpdateApkProvider"
            android:authorities="br.com.trilha.foco.update"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
